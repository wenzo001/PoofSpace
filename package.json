{
  "name": "poofspace",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "PoofSpace - ephemeral, registration-free, multi-party end-to-end encrypted chat rooms",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "release": "node scripts/build-release.mjs",
    "test": "vitest run --reporter=dot --exclude \"tests/perf/**\" && vitest run --reporter=dot tests/perf",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:lifecycle": "vitest run tests/lifecycle",
    "test:perf": "vitest run tests/perf",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "gates": "node scripts/run-gates.mjs",
    "admin:status": "node dist/server/admin-cli.js status",
    "admin:rooms:disconnect-all": "node dist/server/admin-cli.js rooms:disconnect-all",
    "admin:data:purge-all": "node dist/server/admin-cli.js data:purge-all",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^12.4.1",
    "next": "^16.4.0",
    "photoswipe": "5.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
