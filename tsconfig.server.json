{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/lib/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["node_modules", "src/app", "src/components", "tests", "release"]
}
